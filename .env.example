# Express Server Port
PORT=3000

# Fabric Network Configuration
# Path to your local fabric-samples/test-network directory.
# (The backend will auto-detect if fabric-samples is in the parent directory or ~/fabric-samples).
FABRIC_NETWORK_BASE_DIR=../../fabric-samples/test-network
# CCP_PATH=/path/to/connection-org1.json
WALLET_PATH=./wallet
CHANNEL_NAME=mychannel
CHAINCODE_NAME=dispute
MSP_ID=Org1MSP

# Fabric CA Admin Credentials
CA_ADMIN_NAME=admin
CA_ADMIN_SECRET=adminpw

# Fabric Gateway Client Configuration
PEER_ENDPOINT=localhost:7051
PEER_HOST_ALIAS=peer0.org1.example.com

# Security (Set a strong, random secret for JWT signing in production)
JWT_SECRET=your-jwt-secret-keep-this-secure-min-32-chars
