PORT=3000
DB_PATH=./dispute.db

# DEMO KEY: for running locally only. Anyone with this key can re-sign the ledger, so never use
# it for real data. Render generates its own. LEDGER_KEY must be at least 32 characters, and
# changing it makes every existing event fail the check, so run npm run seed again if you do.
LEDGER_KEY=demo-only-ledger-key-not-secret-0123456789
