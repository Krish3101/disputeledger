# ========================================
# Server Configuration
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# Hyperledger Fabric Configuration
# ========================================
CHANNEL=mychannel
CHAINCODE=complaint
MSPID=Org1MSP

# Path to the connection profile (adjust based on your setup)
# Linux/macOS/WSL2:
CCP_PATH=/home/user/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/connection-org1.json

# Windows (PowerShell - use forward slashes or double backslashes):
# CCP_PATH=C:/Users/user/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/connection-org1.json

# ========================================
# Wallet Configuration
# ========================================
# Path to store user identities (relative to app directory)
WALLET_PATH=./wallet

# ========================================
# Certificate Authority Configuration
# ========================================
# CA URL for user enrollment
CA_URL=https://localhost:7054

# ========================================
# Security Configuration (Production)
# ========================================
# Uncomment and set these for production:
# SESSION_SECRET=your-very-long-random-secret-here
# JWT_SECRET=another-very-long-random-secret

# ========================================
# Rate Limiting Configuration
# ========================================
# Time window in milliseconds (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# Logging Configuration
# ========================================
# Log level: error, warn, info, debug
LOG_LEVEL=info
# Log file path (production)
# LOG_FILE_PATH=/var/log/complaint-app

# ========================================
# Notes
# ========================================
# 1. Copy this file to .env and update the values
# 2. Never commit .env file to version control
# 3. Update CCP_PATH to match your fabric-samples location
# 4. For production, use absolute paths and secure secrets
