# Both have working defaults; set them only if you need to.
PORT=3000
DB_PATH=./dispute.db

# Required, at least 32 characters. Keys the hash on every ledger event. scripts/start.sh
# generates one into .env the first time it runs. Changing it later makes every existing
# event fail the integrity check, so delete the database and reseed if you do.
# LEDGER_KEY=

# npm run seed refuses to replace an existing database unless this is 1.
# DEMO_RESEED=1
